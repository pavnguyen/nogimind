# NoGi Mind — Environment Configuration
# Copy this file to .env and fill in values.

# Vite prefix required for client-side env vars
VITE_APP_VERSION=$npm_package_version

# Optional: Set to 'production' for analytics/telemetry
# VITE_ENVIRONMENT=production

# Optional: Analytics (if using)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_POSTHOG_KEY=phc_xxxxxxxx

# Optional: Sentry for error tracking
# VITE_SENTRY_DSN=https://xxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxx
